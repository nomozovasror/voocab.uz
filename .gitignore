# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Claude Code git worktrees (each a full checkout of another branch)
.claude/worktrees/

# uv / virtualenv
.venv/
venv/

# Environment
.env
.env.*
!.env.example
!.env.prod.example
# Vite: committed shared config is safe (no secrets); *.local overrides are not.
!.env.development
.env.*.local

# Local uploaded media (dev fallback when R2 isn't configured)
backend/media/

# scripts/seed_vocabulary.py's own record of which lemmas it wrote for which
# learner, so --reset can find them again on a later run. Per-database, and
# never something another checkout should inherit.
backend/scripts/.seed_vocabulary_state.json

# Third-party content this PUBLIC repository may read but never publish:
# the Cambridge dictionary import's index, match table, samples, decision
# logs and anything else `scripts/cald.py` derives from CALD (see that
# script's docstring). Ignored as a whole directory so a new artefact cannot
# slip through by having a name nobody listed here.
backend/app/data/private

# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Source books and recordings for the seed pipeline. Copyrighted material and
# 2.6GB of it: the pipeline reads from here, and nothing in here is ever
# committed. seed/manifest.json records what was found, which is the part
# worth keeping under version control.
Materials/
seed/.venv/
seed/work/
# Rebuilt in seconds by `seed/db.py init`. Worth backing up once stage progress
# accumulates in it -- that part is real work, not a fact about a file.
#
# Unanchored, so it matches wherever one turns up rather than only in seed/:
# every command in the pipeline takes its path relative to where it was run,
# so running one from the repo root leaves an empty catalogue.db there. That
# is a mis-run to notice, not a file to commit.
catalogue.db
