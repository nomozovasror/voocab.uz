# Production environment for docker-compose.prod.yml.
# Copy to .env.prod (gitignored — NEVER commit) and fill in real values.

# --- Postgres (used by the db service; also composed into DATABASE_URL) ---
POSTGRES_USER=voocab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=voocab

# --- Database (async driver required; host is the compose "db" service) ---
DATABASE_URL=postgresql+asyncpg://voocab:change-me-strong-password@db:5432/voocab

# --- Telegram OIDC (from @BotFather: Web Login + Allowed URLs) ---
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
# Must exactly match the redirect URI registered with BotFather.
TELEGRAM_REDIRECT_URI=https://api.voocab.uz/api/auth/telegram/callback

# --- Session layer ---
# Strong random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# HTTPS in production, so cookies must be Secure.
COOKIE_SECURE=true
# Parent domain so cookies are shared between voocab.uz and api.voocab.uz.
COOKIE_DOMAIN=.voocab.uz
# Where the login callback sends the browser afterwards.
FRONTEND_URL=https://voocab.uz

# --- CORS (comma-separated origins allowed to call the API with credentials) ---
CORS_ORIGINS=https://voocab.uz,https://www.voocab.uz

# --- Cloudflare R2 (audio storage + DB backups; S3-compatible) ---
R2_BUCKET=voocab
# From the R2 dashboard: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2 API token (S3-compatible access key / secret).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public base URL fronting the bucket (enable r2.dev or a custom domain like
# https://media.voocab.uz). Uploaded audio URLs are {R2_PUBLIC_BASE_URL}/{key}.
R2_PUBLIC_BASE_URL=
