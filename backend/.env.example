# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- Database (async driver required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# --- Telegram OIDC (from @BotFather: register Allowed URLs, then copy these) ---
# Client ID (bot id) and client secret (bot token).
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
# Must exactly match a redirect URI registered with BotFather.
TELEGRAM_REDIRECT_URI=http://localhost:5173/api/auth/telegram/callback

# --- Session layer ---
# Strong random string (>=32 bytes), e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# true in production (HTTPS only); false for local http dev.
COOKIE_SECURE=false
# Where the login callback sends the browser afterwards.
FRONTEND_URL=http://localhost:5173
