# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- Database (async driver required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# --- Telegram OIDC (from @BotFather: register Allowed URLs, then copy these) ---
# Client ID (bot id) and client secret (bot token).
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
# Must exactly match a redirect URI registered with BotFather.
TELEGRAM_REDIRECT_URI=http://localhost:5173/api/auth/telegram/callback

# --- Session layer ---
# Strong random string (>=32 bytes), e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# true in production (HTTPS only); false for local http dev.
COOKIE_SECURE=false
# Where the login callback sends the browser afterwards.
FRONTEND_URL=http://localhost:5173

# Dev only: enables POST /api/auth/dev-login (a test-user session without
# Telegram) so local dev needs no tunnel. Leave empty/false everywhere except
# your local .env; it's additionally refused whenever COOKIE_SECURE is true.
DEV_LOGIN_ENABLED=true

# --- Media storage ---
# Leave the R2 vars empty for local dev: uploads are written under ./media and
# served at /media. Set all four (plus R2_PUBLIC_BASE_URL) to use Cloudflare R2.
R2_BUCKET=
R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public base URL fronting the bucket (r2.dev or a custom domain). Required when
# R2 is used; stored audio URLs are {R2_PUBLIC_BASE_URL}/{key}.
R2_PUBLIC_BASE_URL=
