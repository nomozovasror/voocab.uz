# Loaded automatically by Vite in dev (`npm run dev`). Committed shared config —
# no secrets. Override locally with .env.development.local (gitignored).

# Talk directly to the local backend. It's a different origin than the Vite dev
# server (:5173), so this exercises the real CORS + cross-origin cookie path.
# If your backend runs elsewhere (e.g. :8001), override in .env.development.local.
VITE_API_BASE=http://127.0.0.1:8000
