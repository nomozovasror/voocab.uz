# Frontend build-time config. Copy to .env for local overrides (.env is
# gitignored). All vars must be prefixed VITE_ to be exposed to the app.

# Origin of the backend API. Leave EMPTY for local dev — requests then hit the
# same origin and Vite's dev proxy forwards /api to the backend (see
# vite.config.ts). In production set it to the API subdomain so the SPA on
# Cloudflare Pages talks to the backend, e.g.:
#   VITE_API_BASE=https://api.voocab.uz
VITE_API_BASE=
