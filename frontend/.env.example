# Frontend build-time config. All vars must be prefixed VITE_ to be exposed.
#
# VITE_API_BASE — the backend origin the SPA talks to:
#   - dev  → http://localhost:8000  (already set in .env.development)
#   - prod → https://api.voocab.uz  (set in the Cloudflare Pages build env)
#   - ""   → same origin (requests hit "/api/..."), for a reverse-proxy setup
#
# There is nothing to fill in here for a standard local run — .env.development
# already points at the local backend. Copy to .env.local only to override.
VITE_API_BASE=http://localhost:8000
